---
import SectionTitle from '../ui/SectionTitle.astro';
import AnimatedButton from '../ui/AnimatedButton.astro';
import { personalInfo } from '../../data/personalInfo';
---

<section id="about" class="py-20 md:py-32 relative overflow-hidden" data-scroll-section>
  <!-- Background Elements -->
  <div class="absolute inset-0">
    <div class="absolute top-1/4 left-10 w-72 h-72 bg-primary/5 rounded-full blur-3xl"></div>
    <div class="absolute bottom-1/4 right-10 w-96 h-96 bg-primary/3 rounded-full blur-3xl"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    <SectionTitle 
      title="Sobre Mí"
      subtitle="Conoce mi trayectoria, experiencia y la pasión que me impulsa en el desarrollo tecnológico"
    />
    
    <div class="mt-16 grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Image Column -->
      <div class="relative order-2 lg:order-1" data-scroll-reveal>
        <div class="relative group">
          <!-- Main Avatar -->
          <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-dark-800 to-dark-900 p-8 border border-dark-700 group-hover:border-primary/50 transition-all duration-500">
            <img 
              src={personalInfo.avatar}
              alt={`${personalInfo.name} - Profile`}
              class="w-full max-w-sm mx-auto rounded-xl transition-all duration-500 group-hover:scale-105"
              loading="lazy"
            />
            
            <!-- Floating stats -->
            <div class="absolute -top-6 -right-6 bg-primary rounded-2xl p-4 shadow-lg shadow-primary/25 transform rotate-3 group-hover:rotate-6 transition-transform duration-500">
              <div class="text-center">
                <div class="text-2xl font-bold text-white">{personalInfo.yearsExperience}+</div>
                <div class="text-xs text-primary-100">Años</div>
              </div>
            </div>
            
            <div class="absolute -bottom-6 -left-6 bg-dark-800 border border-dark-600 rounded-2xl p-4 shadow-lg transform -rotate-3 group-hover:-rotate-6 transition-transform duration-500">
              <div class="text-center">
                <div class="text-2xl font-bold text-primary">{personalInfo.projectsCompleted}+</div>
                <div class="text-xs text-dark-300">Proyectos</div>
              </div>
            </div>
          </div>
          
          <!-- Decorative elements -->
          <div class="absolute -inset-4 opacity-30 group-hover:opacity-50 transition-opacity duration-500">
            <div class="absolute top-0 left-1/4 w-4 h-4 bg-primary/60 rounded-full animate-pulse"></div>
            <div class="absolute bottom-1/4 right-0 w-2 h-2 bg-primary/40 rounded-full animate-pulse animation-delay-1000"></div>
            <div class="absolute top-3/4 left-0 w-3 h-3 bg-primary/50 rounded-full animate-pulse animation-delay-2000"></div>
          </div>
        </div>
      </div>

      <!-- Content Column -->
      <div class="space-y-8 order-1 lg:order-2" data-scroll-reveal>
        <!-- Bio -->
        <div class="prose prose-lg max-w-none">
          <p class="text-lg text-dark-200 leading-relaxed mb-6">
            {personalInfo.bio}
          </p>
          
          <p class="text-base text-dark-300 leading-relaxed">
            Mi experiencia abarca desde el desarrollo de aplicaciones web complejas hasta la implementación de sistemas de seguridad robustos y la automatización de procesos DevOps.
          </p>
        </div>

        <!-- Key Stats Grid -->
        <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
          <div class="text-center p-4 bg-dark-800/50 rounded-xl border border-dark-700 hover:border-primary/50 transition-all duration-300 group">
            <div class="text-3xl font-bold text-primary mb-2 group-hover:scale-110 transition-transform duration-300">
              {personalInfo.yearsExperience}+
            </div>
            <div class="text-sm text-dark-300">Años de Experiencia</div>
          </div>
          
          <div class="text-center p-4 bg-dark-800/50 rounded-xl border border-dark-700 hover:border-primary/50 transition-all duration-300 group">
            <div class="text-3xl font-bold text-primary mb-2 group-hover:scale-110 transition-transform duration-300">
              {personalInfo.projectsCompleted}+
            </div>
            <div class="text-sm text-dark-300">Proyectos Completados</div>
          </div>
          
          <div class="text-center p-4 bg-dark-800/50 rounded-xl border border-dark-700 hover:border-primary/50 transition-all duration-300 group col-span-2 md:col-span-1">
            <div class="text-3xl font-bold text-primary mb-2 group-hover:scale-110 transition-transform duration-300">
              {personalInfo.technologiesUsed}+
            </div>
            <div class="text-sm text-dark-300">Tecnologías</div>
          </div>
        </div>

        <!-- Skills Highlights -->
        <div class="space-y-4">
          <h3 class="text-xl font-semibold text-foreground mb-4">Especialidades Técnicas</h3>
          
          <div class="grid gap-3">
            {[
              "Desarrollo Full Stack con React, Angular y .NET",
              "DevSecOps con Docker, Kubernetes y CI/CD",
              "Arquitecturas de Microservicios y APIs REST",
              "Seguridad y Ciberseguridad (Zero Trust, cifrado)",
              "Bases de Datos (MongoDB, PostgreSQL, Redis)",
              "Visión Artificial y Robótica (ROS2, LIDAR)"
            ].map((skill, index) => (
              <div 
                class="flex items-start gap-3 p-3 rounded-lg bg-dark-800/30 border border-dark-700/50 hover:bg-dark-800/50 hover:border-primary/30 transition-all duration-300"
                style={`--animation-delay: ${index * 100}ms`}
              >
                <div class="w-2 h-2 bg-primary rounded-full mt-2 flex-shrink-0 animate-pulse"></div>
                <span class="text-dark-200 text-sm leading-relaxed">{skill}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 pt-4">
          <AnimatedButton 
            variant="primary" 
            href="#contact"
            className="flex-1 sm:flex-none"
          >
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
            </svg>
            Hablemos
          </AnimatedButton>
          
          <AnimatedButton 
            variant="outline" 
            href={personalInfo.social.github}
            target="_blank"
            className="flex-1 sm:flex-none"
          >
            <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
            Ver GitHub
          </AnimatedButton>
        </div>

        <!-- Contact Info -->
        <div class="flex flex-col sm:flex-row gap-4 pt-6 border-t border-dark-700/50">
          <div class="flex items-center gap-3 text-sm text-dark-300">
            <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            <span>{personalInfo.location}</span>
          </div>
          
          <div class="flex items-center gap-3 text-sm text-dark-300">
            <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span>{personalInfo.availability}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .animation-delay-1000 { animation-delay: 1s; }
  .animation-delay-2000 { animation-delay: 2s; }

  @media (max-width: 768px) {
    .about-section .grid {
      gap: 2rem;
    }
    
    .about-section .stats-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
