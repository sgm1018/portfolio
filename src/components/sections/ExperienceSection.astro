---
import SectionTitle from '../ui/SectionTitle.astro';
import { experience } from '../../data/experience';
---

<section id="experience" class="py-20 md:py-32 relative overflow-hidden" data-scroll-section>
  <!-- Background Elements -->
  <div class="absolute inset-0">
    <div class="absolute top-1/3 left-10 w-96 h-96 bg-primary/5 rounded-full blur-3xl"></div>
    <div class="absolute bottom-1/4 right-10 w-64 h-64 bg-primary/10 rounded-full blur-2xl"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    <SectionTitle 
      title="Experiencia"
      subtitle="Mi trayectoria profesional y los logros alcanzados en cada etapa de mi carrera"
    />
    
    <!-- Timeline Container -->
    <div class="mt-16 relative">
      <!-- Timeline Line -->
      <div class="absolute left-8 md:left-1/2 top-0 bottom-0 w-px bg-gradient-to-b from-primary via-primary-400 to-primary-600 transform md:-translate-x-1/2"></div>
      
      <!-- Timeline Items -->
      <div class="space-y-12 md:space-y-16">
        {experience.map((exp, index) => (
          <div 
            class={`timeline-item relative ${index % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'} flex flex-col md:flex md:items-center`}
            data-scroll-reveal
            style={`--animation-delay: ${index * 300}ms`}
          >
            <!-- Timeline Dot -->
            <div class="absolute left-8 md:left-1/2 w-4 h-4 bg-primary rounded-full border-4 border-dark-900 transform -translate-x-1/2 z-10 group-hover:scale-125 transition-transform duration-300">
              <div class="absolute inset-0 bg-primary rounded-full animate-ping opacity-75"></div>
            </div>
            
            <!-- Content Card -->
            <div class={`ml-16 md:ml-0 md:w-5/12 ${index % 2 === 0 ? 'md:mr-auto md:pr-8' : 'md:ml-auto md:pl-8'}`}>
              <div class="experience-card group relative overflow-hidden bg-gradient-to-br from-dark-800/90 to-dark-900/90 rounded-2xl border border-dark-700 p-8 backdrop-blur-sm hover:border-primary/50 hover:bg-dark-800/95 transition-all duration-500 hover:scale-[1.02] hover:shadow-xl hover:shadow-primary/10">
                
                <!-- Current Badge -->
                {exp.current && (
                  <div class="absolute top-4 right-4">
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-green-500/20 text-green-400 border border-green-500/30 animate-pulse">
                      <div class="w-2 h-2 bg-green-400 rounded-full mr-2"></div>
                      Actual
                    </span>
                  </div>
                )}
                
                <!-- Company & Position -->
                <div class="mb-4">
                  <h3 class="text-xl md:text-2xl font-bold text-foreground group-hover:text-primary transition-colors duration-300">
                    {exp.position}
                  </h3>
                  <h4 class="text-lg font-semibold text-primary mt-1">
                    {exp.company}
                  </h4>
                  <p class="text-sm text-dark-300 mt-2 flex items-center">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                    </svg>
                    {exp.period}
                  </p>
                </div>

                <!-- Description -->
                <p class="text-dark-200 mb-6 leading-relaxed">
                  {exp.description}
                </p>

                <!-- Technologies -->
                <div class="mb-6">
                  <h5 class="text-sm font-semibold text-foreground mb-3">Tecnologías utilizadas:</h5>
                  <div class="flex flex-wrap gap-2">
                    {exp.technologies.map((tech) => (
                      <span class="px-3 py-1 bg-dark-700/50 text-dark-200 text-xs rounded-lg border border-dark-600 hover:border-primary/50 hover:text-primary transition-all duration-300">
                        {tech}
                      </span>
                    ))}
                  </div>
                </div>

                <!-- Achievements -->
                <div>
                  <h5 class="text-sm font-semibold text-foreground mb-3">Logros principales:</h5>
                  <ul class="space-y-2">
                    {exp.achievements.map((achievement, achIndex) => (
                      <li 
                        class="flex items-start text-dark-200 text-sm group-hover:text-dark-100 transition-colors duration-300"
                        style={`--achievement-delay: ${achIndex * 100}ms`}
                      >
                        <div class="w-1.5 h-1.5 bg-primary rounded-full mt-2 mr-3 flex-shrink-0 opacity-70 group-hover:opacity-100 group-hover:scale-125 transition-all duration-300"></div>
                        <span class="leading-relaxed">{achievement}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <!-- Hover Effects -->
                <div class="absolute inset-0 bg-gradient-to-br from-primary/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 rounded-2xl"></div>
                
                <!-- Shine Effect -->
                <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-700 rounded-2xl overflow-hidden">
                  <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/5 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-1000 skew-x-12"></div>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Experience Summary -->
    <div class="mt-20" data-scroll-reveal>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="text-center p-6 bg-gradient-to-br from-dark-800/80 to-dark-900/80 rounded-xl border border-dark-700 backdrop-blur-sm hover:border-primary/50 transition-all duration-300 group">
          <div class="text-4xl font-bold text-primary mb-2 group-hover:scale-110 transition-transform duration-300">
            {experience.reduce((total, exp) => {
              const startYear = new Date(exp.startDate).getFullYear();
              const endYear = exp.endDate ? new Date(exp.endDate).getFullYear() : new Date().getFullYear();
              return total + (endYear - startYear);
            }, 0)}+
          </div>
          <div class="text-sm text-dark-300">Años de Experiencia</div>
        </div>
        
        <div class="text-center p-6 bg-gradient-to-br from-dark-800/80 to-dark-900/80 rounded-xl border border-dark-700 backdrop-blur-sm hover:border-primary/50 transition-all duration-300 group">
          <div class="text-4xl font-bold text-primary mb-2 group-hover:scale-110 transition-transform duration-300">
            {experience.length}
          </div>
          <div class="text-sm text-dark-300">Empresas</div>
        </div>
        
        <div class="text-center p-6 bg-gradient-to-br from-dark-800/80 to-dark-900/80 rounded-xl border border-dark-700 backdrop-blur-sm hover:border-primary/50 transition-all duration-300 group">
          <div class="text-4xl font-bold text-primary mb-2 group-hover:scale-110 transition-transform duration-300">
            {new Set(experience.flatMap(exp => exp.technologies)).size}
          </div>
          <div class="text-sm text-dark-300">Tecnologías</div>
        </div>
      </div>
    </div>

    <!-- Skills Evolution -->
    <div class="mt-16" data-scroll-reveal>
      <div class="bg-gradient-to-br from-dark-800/90 to-dark-900/90 rounded-2xl p-8 md:p-12 border border-dark-700 backdrop-blur-sm">
        <h3 class="text-2xl md:text-3xl font-bold text-foreground mb-8 text-center">
          Evolución Profesional
        </h3>
        
        <div class="space-y-6">
          {[
            {
              year: "2023-2024",
              title: "DevSecOps Specialist",
              skills: ["Docker", "Security", "CI/CD", "Linux"]
            },
            {
              year: "2024-Presente", 
              title: "Full Stack DevSecOps Developer",
              skills: ["Kubernetes", "Microservices", "AI/ML", "ROS2", "Angular", "Astro"]
            }
          ].map((evolution, index) => (
            <div class="flex flex-col md:flex-row items-start gap-6 p-6 bg-dark-800/50 rounded-xl border border-dark-700/50 hover:bg-dark-800/70 hover:border-primary/30 transition-all duration-300">
              <div class="md:w-1/4">
                <div class="text-lg font-bold text-primary">{evolution.year}</div>
                <div class="text-sm text-dark-300 mt-1">{evolution.title}</div>
              </div>
              
              <div class="md:w-3/4">
                <div class="flex flex-wrap gap-2">
                  {evolution.skills.map((skill) => (
                    <span class="px-3 py-1 bg-primary/10 text-primary text-sm rounded-lg border border-primary/20 hover:bg-primary/20 transition-colors duration-300">
                      {skill}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .timeline-item {
    opacity: 0;
    transform: translateY(50px);
    transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
    transition-delay: var(--animation-delay);
  }

  .timeline-item.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .experience-card {
    position: relative;
  }

  /* Timeline line animation */
  .timeline-item::before {
    content: '';
    position: absolute;
    left: 2rem;
    top: 0;
    bottom: 0;
    width: 1px;
    background: linear-gradient(to bottom, transparent, var(--primary), transparent);
    opacity: 0;
    animation: timeline-reveal 1s ease-out forwards;
    animation-delay: var(--animation-delay);
  }

  @keyframes timeline-reveal {
    to {
      opacity: 1;
    }
  }

  @media (min-width: 768px) {
    .timeline-item::before {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .timeline-item {
      padding-left: 0;
    }
    
    .experience-card {
      margin-left: 0;
      padding: 1.5rem;
    }
  }
</style>
