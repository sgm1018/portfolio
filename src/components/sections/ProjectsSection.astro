---
import SectionTitle from '../ui/SectionTitle.astro';
import ProjectCard from '../ui/ProjectCard.astro';
import { projects, projectCategories } from '../../data/projects';

// Separar proyectos destacados de los regulares
const featuredProjects = projects.filter(p => p.featured);
const regularProjects = projects.filter(p => !p.featured);
---

<section id="projects" class="py-20 md:py-32 relative overflow-hidden" data-scroll-section>
  <!-- Background Elements -->
  <div class="absolute inset-0 opacity-30">
    <div class="absolute top-1/4 right-20 w-64 h-64 bg-primary/10 rounded-full blur-3xl animate-pulse"></div>
    <div class="absolute bottom-1/3 left-20 w-80 h-80 bg-primary/5 rounded-full blur-3xl animate-pulse animation-delay-2000"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    <SectionTitle 
      title="Proyectos"
      subtitle="Una selección de mis trabajos más representativos que demuestran mi experiencia en diferentes tecnologías y dominios"
    />
    
    <!-- Filter Tabs -->
    <div class="mt-12 flex flex-wrap justify-center gap-2 md:gap-4" data-scroll-reveal>
      <div class="project-filters flex flex-wrap gap-2 p-2 bg-dark-800/50 rounded-xl border border-dark-700 backdrop-blur-sm">
        {projectCategories.map((category, index) => (
          <button 
            class={`filter-btn px-4 py-2 rounded-lg font-medium transition-all duration-300 text-sm md:text-base ${index === 0 ? 'active' : ''}`}
            data-filter={category === 'Todos' ? 'all' : category}
          >
            {category}
          </button>
        ))}
      </div>
    </div>

    <!-- Featured Projects -->
    {featuredProjects.length > 0 && (
      <div class="mt-16" data-scroll-reveal>
        <h3 class="text-2xl md:text-3xl font-bold text-foreground mb-8 text-center">
          <span class="text-primary">★</span> Proyectos Destacados
        </h3>
        
        <div class="grid gap-8">
          {featuredProjects.map((project, index) => (
            <div 
              class="project-item featured-project" 
              data-category={project.category}
              style={`--animation-delay: ${index * 200}ms`}
            >
              <ProjectCard project={project} featured={true} />
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Regular Projects Grid -->
    <div class="mt-16" data-scroll-reveal>
      {regularProjects.length > 0 && (
        <h3 class="text-2xl md:text-3xl font-bold text-foreground mb-8 text-center">
          Otros Proyectos
        </h3>
      )}
      
      <div class="projects-grid grid md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        {regularProjects.map((project, index) => (
          <div 
            class="project-item regular-project" 
            data-category={project.category}
            style={`--animation-delay: ${(index + featuredProjects.length) * 100}ms`}
          >
            <ProjectCard project={project} />
          </div>
        ))}
      </div>
    </div>

    <!-- Project Stats -->
    <div class="mt-20" data-scroll-reveal>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        <div class="stat-card text-center p-6 bg-gradient-to-br from-dark-800/80 to-dark-900/80 rounded-xl border border-dark-700 backdrop-blur-sm group hover:border-primary/50 transition-all duration-300">
          <div class="text-3xl font-bold text-primary mb-2 group-hover:scale-110 transition-transform duration-300">
            {projects.length}
          </div>
          <div class="text-sm text-dark-300">Proyectos Totales</div>
        </div>
        
        <div class="stat-card text-center p-6 bg-gradient-to-br from-dark-800/80 to-dark-900/80 rounded-xl border border-dark-700 backdrop-blur-sm group hover:border-primary/50 transition-all duration-300">
          <div class="text-3xl font-bold text-primary mb-2 group-hover:scale-110 transition-transform duration-300">
            {projects.filter(p => p.status === 'completed').length}
          </div>
          <div class="text-sm text-dark-300">Completados</div>
        </div>
        
        <div class="stat-card text-center p-6 bg-gradient-to-br from-dark-800/80 to-dark-900/80 rounded-xl border border-dark-700 backdrop-blur-sm group hover:border-primary/50 transition-all duration-300">
          <div class="text-3xl font-bold text-primary mb-2 group-hover:scale-110 transition-transform duration-300">
            {new Set(projects.flatMap(p => p.technologies)).size}
          </div>
          <div class="text-sm text-dark-300">Tecnologías</div>
        </div>
        
        <div class="stat-card text-center p-6 bg-gradient-to-br from-dark-800/80 to-dark-900/80 rounded-xl border border-dark-700 backdrop-blur-sm group hover:border-primary/50 transition-all duration-300">
          <div class="text-3xl font-bold text-primary mb-2 group-hover:scale-110 transition-transform duration-300">
            {projectCategories.length - 1}
          </div>
          <div class="text-sm text-dark-300">Categorías</div>
        </div>
      </div>
    </div>

    <!-- CTA Section -->
    <div class="mt-20 text-center" data-scroll-reveal>
      <div class="relative inline-block">
        <div class="absolute inset-0 bg-gradient-to-r from-primary/20 to-primary/30 rounded-2xl blur-xl"></div>
        <div class="relative bg-gradient-to-br from-dark-800/90 to-dark-900/90 rounded-2xl p-8 md:p-12 border border-dark-700 backdrop-blur-sm">
          <h3 class="text-2xl md:text-3xl font-bold text-foreground mb-4">
            ¿Tienes un proyecto en mente?
          </h3>
          <p class="text-lg text-dark-300 mb-8 max-w-2xl mx-auto">
            Me encantaría conocer tu idea y ayudarte a convertirla en realidad con las mejores tecnologías y prácticas.
          </p>
          
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a 
              href="#contact"
              class="inline-flex items-center px-8 py-4 bg-primary hover:bg-primary-600 text-white font-semibold rounded-xl transition-all duration-300 hover:scale-105 hover:shadow-lg hover:shadow-primary/25 group"
            >
              <svg class="w-5 h-5 mr-2 transition-transform group-hover:rotate-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"></path>
              </svg>
              Colaborar Juntos
            </a>
            
            <a 
              href="https://github.com/sgm1018"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center px-8 py-4 bg-transparent hover:bg-dark-800 text-foreground font-semibold rounded-xl transition-all duration-300 hover:scale-105 border border-dark-600 hover:border-primary/50 group"
            >
              <svg class="w-5 h-5 mr-2 transition-transform group-hover:rotate-12" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
              </svg>
              Ver en GitHub
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .project-item {
    opacity: 0;
    transform: translateY(50px);
    transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
    transition-delay: var(--animation-delay);
  }

  .project-item.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .project-item.hidden {
    opacity: 0;
    transform: translateY(50px) scale(0.95);
    pointer-events: none;
  }

  .filter-btn {
    background: transparent;
    color: var(--dark-300);
    border: 1px solid var(--dark-600);
  }

  .filter-btn:hover,
  .filter-btn.active {
    background: var(--primary);
    color: white;
    border-color: var(--primary);
    transform: translateY(-2px);
  }

  .stat-card {
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .stat-card.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .animation-delay-2000 {
    animation-delay: 2s;
  }

  @media (max-width: 768px) {
    .projects-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    
    .filter-btn {
      font-size: 0.875rem;
      padding: 0.5rem 0.75rem;
    }
    
    .stat-card {
      padding: 1rem;
    }
  }
</style>

<script>
// Project filtering functionality
document.addEventListener('DOMContentLoaded', function() {
  const filterBtns = document.querySelectorAll('.filter-btn');
  const projectItems = document.querySelectorAll('.project-item');
  
  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter;
      
      // Update active button
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      
      // Filter projects
      projectItems.forEach(item => {
        const category = item.dataset.category;
        
        if (filter === 'all' || category === filter) {
          item.classList.remove('hidden');
          setTimeout(() => item.classList.add('visible'), 100);
        } else {
          item.classList.add('hidden');
          item.classList.remove('visible');
        }
      });
    });
  });
});
</script>
