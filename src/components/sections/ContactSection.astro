---
import SectionTitle from '../ui/SectionTitle.astro';
import AnimatedButton from '../ui/AnimatedButton.astro';
import { personalInfo } from '../../data/personalInfo';
---

<section id="contact" class="py-20 md:py-32 relative overflow-hidden bg-gradient-to-b from-dark-900/50 to-dark-900" data-scroll-section>
  <!-- Background Elements -->
  <div class="absolute inset-0">
    <div class="absolute top-20 left-1/4 w-96 h-96 bg-primary/10 rounded-full blur-3xl animate-pulse"></div>
    <div class="absolute bottom-20 right-1/4 w-64 h-64 bg-primary/5 rounded-full blur-2xl animate-pulse animation-delay-2000"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    <SectionTitle 
      title="Contacto"
      subtitle="¿Tienes un proyecto en mente? Hablemos y hagamos realidad tus ideas juntos"
    />
    
    <div class="mt-16 grid lg:grid-cols-2 gap-12 lg:gap-16">
      <!-- Contact Info -->
      <div class="space-y-8" data-scroll-reveal data-animation="fade-right">
        <!-- Contact Cards -->
        <div class="space-y-6">
          <!-- Email -->
          <div class="contact-card group flex items-start gap-6 p-6 bg-gradient-to-br from-dark-800/80 to-dark-900/80 rounded-xl border border-dark-700 hover:border-primary/50 backdrop-blur-sm transition-all duration-300 hover:scale-[1.02]">
            <div class="flex-shrink-0">
              <div class="w-12 h-12 bg-gradient-to-br from-primary/20 to-primary/10 rounded-xl flex items-center justify-center border border-primary/20 group-hover:border-primary/40 group-hover:scale-110 transition-all duration-300">
                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
              </div>
            </div>
            <div class="flex-1">
              <h3 class="text-lg font-semibold text-foreground group-hover:text-primary transition-colors duration-300">Email</h3>
              <p class="text-dark-300 mt-1">Respuesta en menos de 24 horas</p>
              <a 
                href={`mailto:${personalInfo.email}`}
                class="text-primary hover:text-primary-400 font-medium mt-2 inline-block transition-colors duration-300"
              >
                {personalInfo.email}
              </a>
            </div>
          </div>

          <!-- Location -->
          <div class="contact-card group flex items-start gap-6 p-6 bg-gradient-to-br from-dark-800/80 to-dark-900/80 rounded-xl border border-dark-700 hover:border-primary/50 backdrop-blur-sm transition-all duration-300 hover:scale-[1.02]">
            <div class="flex-shrink-0">
              <div class="w-12 h-12 bg-gradient-to-br from-primary/20 to-primary/10 rounded-xl flex items-center justify-center border border-primary/20 group-hover:border-primary/40 group-hover:scale-110 transition-all duration-300">
                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
              </div>
            </div>
            <div class="flex-1">
              <h3 class="text-lg font-semibold text-foreground group-hover:text-primary transition-colors duration-300">Ubicación</h3>
              <p class="text-dark-300 mt-1">Trabajo remoto y presencial</p>
              <p class="text-primary font-medium mt-2">{personalInfo.location}</p>
            </div>
          </div>

          <!-- Availability -->
          <div class="contact-card group flex items-start gap-6 p-6 bg-gradient-to-br from-dark-800/80 to-dark-900/80 rounded-xl border border-dark-700 hover:border-primary/50 backdrop-blur-sm transition-all duration-300 hover:scale-[1.02]">
            <div class="flex-shrink-0">
              <div class="w-12 h-12 bg-gradient-to-br from-primary/20 to-primary/10 rounded-xl flex items-center justify-center border border-primary/20 group-hover:border-primary/40 group-hover:scale-110 transition-all duration-300">
                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
            </div>
            <div class="flex-1">
              <h3 class="text-lg font-semibold text-foreground group-hover:text-primary transition-colors duration-300">Disponibilidad</h3>
              <p class="text-dark-300 mt-1">Horario de trabajo flexible</p>
              <p class="text-primary font-medium mt-2">{personalInfo.availability}</p>
            </div>
          </div>
        </div>

        <!-- Social Links -->
        <div class="pt-6 border-t border-dark-700">
          <h3 class="text-lg font-semibold text-foreground mb-4">Sígueme en</h3>
          <div class="flex gap-4">
            <a 
              href={personalInfo.social.github}
              target="_blank"
              rel="noopener noreferrer"
              class="w-12 h-12 bg-gradient-to-br from-dark-800 to-dark-900 rounded-xl flex items-center justify-center border border-dark-700 hover:border-primary hover:bg-primary/10 transition-all duration-300 hover:scale-110 group"
              aria-label="GitHub"
            >
              <svg class="w-6 h-6 text-dark-300 group-hover:text-primary transition-colors duration-300" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
              </svg>
            </a>
            
            <a 
              href={personalInfo.social.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="w-12 h-12 bg-gradient-to-br from-dark-800 to-dark-900 rounded-xl flex items-center justify-center border border-dark-700 hover:border-primary hover:bg-primary/10 transition-all duration-300 hover:scale-110 group"
              aria-label="LinkedIn"
            >
              <svg class="w-6 h-6 text-dark-300 group-hover:text-primary transition-colors duration-300" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </a>
            
            <a 
              href={`mailto:${personalInfo.email}`}
              class="w-12 h-12 bg-gradient-to-br from-dark-800 to-dark-900 rounded-xl flex items-center justify-center border border-dark-700 hover:border-primary hover:bg-primary/10 transition-all duration-300 hover:scale-110 group"
              aria-label="Email"
            >
              <svg class="w-6 h-6 text-dark-300 group-hover:text-primary transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="contact-form" data-scroll-reveal data-animation="fade-left">
        <div class="bg-gradient-to-br from-dark-800/90 to-dark-900/90 rounded-2xl p-8 md:p-10 border border-dark-700 backdrop-blur-sm">
          <form 
            action={personalInfo.contact.formEndpoint}
            method="POST"
            class="space-y-6"
            id="contact-form"
          >
            <!-- Hidden fields for FormSubmit -->
            <input type="hidden" name="_captcha" value="false">
            <input type="hidden" name="_template" value="table">
            <input type="hidden" name="_subject" value="Nuevo mensaje desde tu portfolio">
            
            <!-- Name -->
            <div class="form-group">
              <label for="name" class="block text-sm font-semibold text-foreground mb-2">
                Nombre *
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full px-4 py-3 bg-dark-800/50 border border-dark-600 rounded-xl text-foreground placeholder-dark-400 focus:border-primary focus:ring-4 focus:ring-primary/10 focus:outline-none transition-all duration-300 hover:border-dark-500"
                placeholder="Tu nombre completo"
              />
            </div>

            <!-- Email -->
            <div class="form-group">
              <label for="email" class="block text-sm font-semibold text-foreground mb-2">
                Email *
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 bg-dark-800/50 border border-dark-600 rounded-xl text-foreground placeholder-dark-400 focus:border-primary focus:ring-4 focus:ring-primary/10 focus:outline-none transition-all duration-300 hover:border-dark-500"
                placeholder="tu@email.com"
              />
            </div>

            <!-- Subject -->
            <div class="form-group">
              <label for="subject" class="block text-sm font-semibold text-foreground mb-2">
                Asunto
              </label>
              <input
                type="text"
                id="subject"
                name="subject"
                class="w-full px-4 py-3 bg-dark-800/50 border border-dark-600 rounded-xl text-foreground placeholder-dark-400 focus:border-primary focus:ring-4 focus:ring-primary/10 focus:outline-none transition-all duration-300 hover:border-dark-500"
                placeholder="¿En qué puedo ayudarte?"
              />
            </div>

            <!-- Message -->
            <div class="form-group">
              <label for="message" class="block text-sm font-semibold text-foreground mb-2">
                Mensaje *
              </label>
              <textarea
                id="message"
                name="message"
                rows="6"
                required
                class="w-full px-4 py-3 bg-dark-800/50 border border-dark-600 rounded-xl text-foreground placeholder-dark-400 focus:border-primary focus:ring-4 focus:ring-primary/10 focus:outline-none transition-all duration-300 hover:border-dark-500 resize-none"
                placeholder="Cuéntame sobre tu proyecto o idea..."
              ></textarea>
            </div>

            <!-- Submit Button -->
            <div class="pt-2">
              <AnimatedButton
                type="submit"
                variant="primary"
                size="lg"
                className="w-full"
              >
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
                </svg>
                Enviar Mensaje
              </AnimatedButton>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- Additional CTA -->
    <div class="mt-16 text-center" data-scroll-reveal>
      <div class="inline-flex items-center gap-4 p-4 bg-primary/10 rounded-xl border border-primary/20">
        <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
        </svg>
        <span class="text-sm text-primary font-medium">
          ¿Prefieres una llamada? Podemos coordinar una videollamada para hablar de tu proyecto
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-card,
  .contact-form {
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .contact-card.visible,
  .contact-form.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .form-group input:focus,
  .form-group textarea:focus {
    transform: translateY(-2px);
  }

  .form-group input:valid,
  .form-group textarea:valid {
    border-color: var(--primary);
  }

  .animation-delay-2000 {
    animation-delay: 2s;
  }

  /* Form validation styles */
  .form-group input:invalid:not(:placeholder-shown),
  .form-group textarea:invalid:not(:placeholder-shown) {
    border-color: #ef4444;
  }

  .form-group input:valid:not(:placeholder-shown),
  .form-group textarea:valid:not(:placeholder-shown) {
    border-color: var(--primary);
  }

  @media (max-width: 768px) {
    .contact-card {
      padding: 1rem 1.5rem;
    }
    
    .contact-form {
      padding: 1.5rem;
    }
  }
</style>

<script>
// Form enhancement
document.addEventListener('DOMContentLoaded', function() {
  const form = document.getElementById('contact-form') as HTMLFormElement;
  
  if (form) {
    form.addEventListener('submit', function(e) {
      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      
      if (submitBtn) {
        // Add loading state
        submitBtn.setAttribute('data-loading', 'true');
        submitBtn.disabled = true;
        
        // Reset after form submission (FormSubmit will redirect)
        setTimeout(() => {
          submitBtn.removeAttribute('data-loading');
          submitBtn.disabled = false;
        }, 2000);
      }
    });

    // Real-time validation
    const inputs = form.querySelectorAll('input, textarea');
    inputs.forEach(input => {
      input.addEventListener('input', function() {
        const isValid = (input as HTMLInputElement).checkValidity();
        input.classList.toggle('valid', isValid);
      });
    });
  }
});
</script>
