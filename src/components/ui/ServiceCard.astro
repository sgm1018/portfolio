---
import type { Service } from '../../data/services';

interface Props {
  service: Service;
  index?: number;
}

const { service, index = 0 } = Astro.props;
const animationDelay = index * 200; // Stagger animation
---

<article 
  class="service-card group relative overflow-hidden"
  data-scroll-reveal
  style={`--animation-delay: ${animationDelay}ms`}
>
  <!-- Card Background -->
  <div class="relative h-full bg-gradient-to-br from-dark-800/80 to-dark-900/90 rounded-2xl border border-dark-700 p-8 backdrop-blur-sm transition-all duration-500 hover:border-primary/50 hover:bg-dark-800/90 hover:scale-[1.02] hover:shadow-2xl hover:shadow-primary/10">
    
    <!-- Service Number -->
    <div class="absolute top-6 right-6">
      <span class="text-6xl font-bold text-primary/20 group-hover:text-primary/30 transition-colors duration-500">
        {service.id}
      </span>
    </div>

    <!-- Icon Container -->
    <div class="relative mb-6">
      <div class="w-20 h-20 bg-gradient-to-br from-primary/20 to-primary/10 rounded-2xl flex items-center justify-center border border-primary/20 group-hover:border-primary/40 transition-all duration-500 group-hover:scale-110 group-hover:rotate-3">
        <i class={`${service.icon} text-3xl text-primary group-hover:text-primary-400 transition-all duration-500`}></i>
      </div>
      
      <!-- Floating particles effect -->
      <div class="absolute -inset-2 opacity-0 group-hover:opacity-100 transition-opacity duration-700">
        <div class="absolute top-0 left-0 w-2 h-2 bg-primary/60 rounded-full animate-ping animation-delay-0"></div>
        <div class="absolute bottom-0 right-0 w-1 h-1 bg-primary/40 rounded-full animate-ping animation-delay-1000"></div>
        <div class="absolute top-1/2 right-0 w-1.5 h-1.5 bg-primary/50 rounded-full animate-ping animation-delay-500"></div>
      </div>
    </div>

    <!-- Content -->
    <div class="relative z-10">
      <h3 class="text-2xl font-bold text-foreground mb-4 group-hover:text-primary transition-colors duration-300">
        {service.title}
      </h3>
      
      <p class="text-dark-300 mb-6 leading-relaxed text-base">
        {service.description}
      </p>

      <!-- Features List -->
      <ul class="space-y-3 mb-8">
        {service.features.map((feature, featureIndex) => (
          <li class="flex items-center text-dark-200 group-hover:text-dark-100 transition-colors duration-300" style={`--feature-delay: ${featureIndex * 100}ms`}>
            <div class="w-2 h-2 bg-primary rounded-full mr-3 flex-shrink-0 opacity-70 group-hover:opacity-100 group-hover:scale-125 transition-all duration-300"></div>
            <span class="text-sm font-medium">{feature}</span>
          </li>
        ))}
      </ul>

      <!-- CTA Button -->
      <div class="relative overflow-hidden">
        <button class="w-full py-3 px-6 bg-gradient-to-r from-primary/90 to-primary text-white font-semibold rounded-xl transition-all duration-500 hover:from-primary hover:to-primary-600 hover:scale-105 hover:shadow-lg hover:shadow-primary/25 group/btn relative overflow-hidden">
          <span class="relative z-10 flex items-center justify-center">
            Explorar
            <svg class="w-4 h-4 ml-2 transition-transform group-hover/btn:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </span>
          
          <!-- Button hover effect -->
          <div class="absolute inset-0 bg-gradient-to-r from-primary-400 to-primary-500 transform -translate-x-full group-hover/btn:translate-x-0 transition-transform duration-500"></div>
        </button>
      </div>
    </div>

    <!-- Background decorative elements -->
    <div class="absolute inset-0 overflow-hidden">
      <!-- Gradient overlay -->
      <div class="absolute inset-0 bg-gradient-to-br from-primary/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
      
      <!-- Geometric shapes -->
      <div class="absolute -bottom-10 -right-10 w-32 h-32 bg-primary/5 rounded-full blur-2xl group-hover:bg-primary/10 transition-colors duration-700"></div>
      <div class="absolute -top-5 -left-5 w-20 h-20 bg-primary/5 rounded-full blur-xl group-hover:bg-primary/8 transition-colors duration-700"></div>
    </div>

    <!-- Shine effect -->
    <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-700">
      <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/5 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-1000 skew-x-12"></div>
    </div>
  </div>
</article>

<style>
  .service-card {
    opacity: 0;
    transform: translateY(50px) rotateX(10deg);
    transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
    transition-delay: var(--animation-delay);
  }

  .service-card.visible {
    opacity: 1;
    transform: translateY(0) rotateX(0deg);
  }

  .animation-delay-0 { animation-delay: 0ms; }
  .animation-delay-500 { animation-delay: 500ms; }
  .animation-delay-1000 { animation-delay: 1000ms; }

  @keyframes ping {
    75%, 100% {
      transform: scale(2);
      opacity: 0;
    }
  }

  .animate-ping {
    animation: ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @media (max-width: 768px) {
    .service-card {
      margin-bottom: 2rem;
    }
    
    .service-card .text-6xl {
      font-size: 3rem;
    }
    
    .service-card h3 {
      font-size: 1.5rem;
    }
  }
</style>
