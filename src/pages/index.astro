---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import HeroSection from "../components/HeroSection.astro";
import AnimationController from "../components/AnimationController.astro";
---

<Layout title="Sergio González Martínez - Portfolio">
  <Navbar />
  <AnimationController />
  <style>
    .enhanced-card {
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.1) 0%, rgba(255, 255, 255, 0.05) 100%);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 1.5rem;
      transition:     </section>

    <section id="contact" class="py-32 relative overflow-hidden">0.4s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      overflow: hidden;
    }

    .tech-row {
      position: relative;
      width: 100%;
      height: 80px;
      overflow: hidden;
      mask: linear-gradient(
        90deg,
        transparent,
        white 10%,
        white 90%,
        transparent
      );
      -webkit-mask: linear-gradient(
        90deg,
        transparent,
        white 10%,
        white 90%,
        transparent
      );
    }

    .tech-track {
      position: absolute;
      top: 0;
      left: 0;
      height: 100%;
      white-space: nowrap;
      will-change: transform;
    }

    .tech-icon-item {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 80px;
      height: 64px;
      flex-shrink: 0;
      position: relative;
    }

    .tech-icon-item i {
      transition: color 0.3s ease;
    }

    .enhanced-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 30, 86, 0.1), transparent);
      transition: left 0.6s ease;
    }

    .enhanced-card:hover::before {
      left: 100%;
    }

    .tech-icon {
      position: relative;
      aspect-ratio: 1;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .service-card {
      padding: 0;
    }

    .portfolio-item {
      background: linear-gradient(135deg, rgba(26, 27, 30, 0.9) 0%, rgba(26, 27, 30, 0.8) 100%);
    }

    @media (max-width: 768px) {
      .enhanced-card {
        padding: 1.5rem;
      }
    }
  </style>

  <main>
    <HeroSection />

    <section id="services" class="py-20 relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-dark-900 via-dark-800 to-dark-900"></div>
      <div class="absolute inset-0 opacity-20" style="background-image: url('data:image/svg+xml,%3Csvg width=\"60\" height=\"60\" viewBox=\"0 0 60 60\" xmlns=\"http://www.w3.org/2000/svg\"%3E%3Cg fill=\"none\" fill-rule=\"evenodd\"%3E%3Cg fill=\"%23FF1E56\" fill-opacity=\"0.1\"%3E%3Ccircle cx=\"30\" cy=\"30\" r=\"4\"/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"></div>
      
      <div class="container mx-auto px-6 relative z-10">
        <div class="text-center mb-20">
          <div class="inline-flex items-center gap-3 mb-6">
            <div class="w-12 h-0.5 bg-gradient-to-r from-transparent to-primary"></div>
            <span class="text-primary font-semibold tracking-widest uppercase text-sm">Servicios</span>
            <div class="w-12 h-0.5 bg-gradient-to-l from-transparent to-primary"></div>
          </div>
          <h2 class="text-6xl font-black mb-6 text-white">
            ¿Cómo puedo <span class="text-primary">ayudarte?</span>
          </h2>
          <p class="text-dark-200 text-xl max-w-3xl mx-auto leading-relaxed">
            Ofrezco soluciones completas, desde la estructuración del proyecto, construcción y su despliegue, siguiendo las mejores técnicas SDLC para un desarrollo seguro.
          </p>
        </div>

        <div class="space-y-8">
          {
            [
              {
                number: "01",
                title: "Desarrollo Web Full Stack",
                description: "Aplicaciones web completas con arquitecturas modernas, APIs robustas y interfaces de usuario excepcionales.",
                features: ["Frontend Moderno", "APIs RESTful", "Bases de Datos", "UI/UX Design"],
                color: "from-primary/20 to-primary-600/20",
                icon: "🌐"
              },
              {
                number: "02", 
                title: "DevSecOps & Cloud",
                description: "Automatización de despliegues, infraestructura como código y implementación de prácticas de seguridad desde el desarrollo.",
                features: ["SDLC", "SAST", "DAST", "Docker", "Kubernetes", "HELM", "CI/CD Pipelines", "Containerización", "Security First"],
                color: "from-primary/20 to-primary-600/20",
                icon: "🚀"
              },
              {
                number: "03",
                title: "Consultoría Técnica",
                description: "Asesoramiento estratégico en arquitectura de software, selección de tecnologías y optimización de procesos de desarrollo.",
                features: ["Arquitectura de Software", "Code Reviews", "Tech Stack", "Best Practices"],
                color: "from-primary/20 to-primary-600/20", 
                icon: "💡"
              },
              {
                number: "04",
                title: "Aplicaciones Móviles",
                description: "Desarrollo de aplicaciones nativas y multiplataforma para iOS y Android con rendimiento óptimo.",
                features: ["React Native", "Flutter", "Native iOS/Android", "Cross-platform"],
                color: "from-primary/20 to-primary-600/20",
                icon: "📱"
              }
            ].map((service, index) => (
              <div class={`service-card flex items-center gap-8 py-6 ${index % 2 === 1 ? 'flex-row-reverse' : ''}`}>
                <div class="flex-shrink-0">
                  <div class="relative">
                    <span class="text-8xl font-black text-dark-700 select-none">{service.number}</span>
                    <div class={`absolute -top-2 -left-2 w-20 h-20 rounded-full bg-gradient-to-r ${service.color} opacity-20 blur-xl`}></div>
                  </div>
                </div>

                <div class="flex-1 min-w-0">
                  <div class="bg-gradient-to-br from-primary/10 to-primary/5 backdrop-blur-sm rounded-2xl p-8 border border-primary/20 hover:border-primary/40 transition-all duration-500">
                    <div class="flex items-center gap-4 mb-4">
                      <div class="w-12 h-12 rounded-xl bg-primary/20 border border-primary/30 flex items-center justify-center text-xl">
                        {service.icon}
                      </div>
                      <h3 class="text-2xl font-bold text-white">{service.title}</h3>
                    </div>
                    
                    <p class="text-gray-300 text-lg mb-6 leading-relaxed">
                      {service.description}
                    </p>
                    
                    <div class="flex flex-wrap gap-3">
                      {service.features.map((feature, featureIndex) => (
                        <span class="px-4 py-2 rounded-full text-sm font-medium bg-primary/20 text-primary-200 border border-primary/30 hover:bg-primary/30 transition-colors">
                          {feature}
                        </span>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section id="portfolio" class="py-20 relative">
      <div class="container mx-auto px-6">
        <div class="text-center mb-20">
          <h2 class="text-5xl font-black mb-6 bg-gradient-to-r from-white to-gray-300 bg-clip-text text-transparent">
            Mi <span class="bg-gradient-to-r from-primary to-primary-400 bg-clip-text text-transparent">Portfolio</span>
          </h2>
          <p class="text-dark-200 text-xl max-w-3xl mx-auto leading-relaxed">
            Una selección de mis proyectos más recientes y destacados, donde combino innovación técnica con diseño excepcional
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {
            [
              {
                title: "GitLLMTrainer",
                description: "Herramienta para scrapear repositorios de GitHub y generar conjuntos de datos para entrenar LLMs.",
                image: "/LLMICON.png",
                tags: ["Python"],
                demo: "https://github.com/sgm1018/GitLLMTrainer",
                github: "https://github.com/sgm1018/GitLLMTrainer",
                category: "AI/ML"
              },
              {
                title: "Web App builder",
                description: "Generador de aplicaciones web completas con base de datos, API, UI moderna, autentificacion con token JWT, chat, gestión de roles y despliegue.",
                image: "/builder.png",
                tags: [".NET", "Angular", "Docker", "WebSockets", "JWT", "Mongo DB", "Tailwind CSS"],
                demo: "https://github.com/tfgsergiogonzalezmartinez/stack_generador",
                github: "https://github.com/tfgsergiogonzalezmartinez/stack_generador",
                category: "Full Stack"
              },
              {
                title: "Star Repo Graph",
                description: "Aplicación para capturar stars de repositorios de GitHub y generar gráficos elegantes.",
                image: "/stars.png",
                tags: ["Astro", "Redis", "Tailwind CSS"],
                demo: "https://github.com/sgm1018/star-repo-graph",
                github: "https://github.com/sgm1018/star-repo-graph",
                category: "Data Viz"
              },
              {
                title: "TeacherCloud",
                description: "Plataforma de gestión de cursos en línea para profesores y estudiantes.",
                image: "/teachercloud.png",
                tags: ["Spring Boot", "Angular", "MySQL", "Docker", "Tailwind CSS"],
                demo: "https://github.com/sgm1018/TeacherCloud/tree/desarrollo",
                github: "https://github.com/sgm1018/TeacherCloud/tree/desarrollo",
                category: "Education"
              }
            ].map((project, index) => (
              <div class="portfolio-item enhanced-card group overflow-hidden cursor-pointer relative">
                <div class="absolute top-4 left-4 z-20 bg-gradient-to-r from-primary to-primary-400 text-white px-3 py-1 rounded-full text-xs font-bold tracking-wide">
                  {project.category}
                </div>
                
                <div class="relative aspect-video bg-dark-700 overflow-hidden">
                  <img
                    src={project.image}
                    alt={project.title}
                    class="w-full h-full object-cover transition-all duration-500"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-dark-900/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                  
                  <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                    <div class="flex gap-4">
                      <a
                        href={project.demo}
                        target="_blank"
                        class="bg-primary/90 backdrop-blur-sm text-white px-6 py-3 rounded-full font-semibold hover:bg-primary transition-colors duration-300 flex items-center gap-2 shadow-lg"
                      >
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                        </svg>
                        Demo
                      </a>
                      <a
                        href={project.github}
                        target="_blank"
                        class="bg-dark-800/90 backdrop-blur-sm text-white px-6 py-3 rounded-full font-semibold hover:bg-dark-700 transition-colors duration-300 flex items-center gap-2 shadow-lg border border-gray-600"
                      >
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M10 0C4.477 0 0 4.484 0 10.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0110 4.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.203 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.942.359.31.678.921.678 1.856 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0020 10.017C20 4.484 15.522 0 10 0z" clip-rule="evenodd"/>
                        </svg>
                        Code
                      </a>
                    </div>
                  </div>
                </div>
                
                <div class="p-6 flex flex-col flex-grow">
                  <h3 class="text-xl font-bold mb-3 text-white group-hover:text-primary transition-colors duration-300">
                    {project.title}
                  </h3>
                  <p class="text-dark-300 mb-4 leading-relaxed group-hover:text-dark-200 transition-colors duration-300">
                    {project.description}
                  </p>
                  
                  <div class="flex flex-wrap gap-2 mt-auto">
                    {project.tags.map((tag, tagIndex) => (
                      <span class="px-3 py-1.5 rounded-full text-xs font-semibold bg-primary/15 text-primary-200 border border-primary/25 hover:bg-primary/25 hover:text-primary-100 transition-all duration-300 backdrop-blur-sm">
                        {tag}
                      </span>
                    ))}
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section id="experience" class="py-20 bg-dark-800/50">
      <div class="container mx-auto px-6">
        <div class="text-center mb-16">
          <h2 class="text-4xl font-bold mb-4">Experiencia <span class="text-primary">Profesional</span> </h2>
          <p class="text-dark-300 max-w-2xl mx-auto">
            Mi trayectoria profesional
          </p>
        </div>

        <div class="max-w-3xl mx-auto">
          {
            [
              {
                period: "2024 - Presente",
                company: "TCH Labs",
                position: "Full Stack DevSecOps developer",
                description:
                  "Diseño y desarrollo de APIs avanzadas con seguridad robusta, interfaces modernas con Angular y Astro, despliegue en Kubernetes, optimización con Redis y Memcached, y creación de aplicaciones complejas. Implementación de pipelines CI/CD con GitLab. Experiencia en visión artificial, robótica, control de almacenes automáticos, y modelos de lenguaje (LLMs, RAG, Fine-tuning). Conocimientos avanzados en frontend (Angular, Astro, Tailwind CSS), backend (APIs REST, SOAP, MQTT, SQL/NoSQL, .NET, Nest), DevSecOps (Apache, Nginx, Docker, Kubernetes, CI/CD, Ansible y Terraform), y robótica (AGVs, ROS2, LIDAR).",
              },{
              period: "2023 - 2024",
                company: "CSA - Centro Regional de Servicios Avanzados",
                position: "DevSecOps",
                description:
                  "Especializado en despliegues seguros con Docker con un perfil DevSecOps en el departamento de ciberseguridad. he participado, desarrollado y desplegado aplicaciones con un importante enfoque en la seguridad",
              },
            ].map((exp, index, array) => (
              <div class="relative pl-10 pb-12 timeline-dot last:pb-0">
                <div
                  class={`${index !== array.length - 1 ? "timeline-line" : ""}`}
                >
                  <div class="bg-dark-800 p-6 rounded-lg border border-dark-700 hover:border-primary transition-colors duration-300">
                    <span class="text-primary font-medium">{exp.period}</span>
                    <h3 class="text-xl font-bold mt-2">{exp.position}</h3>
                    <p class="text-dark-300 mt-1">{exp.company}</p>
                    <p class="text-dark-400 mt-4">{exp.description}</p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section id="technologies" class="py-20 relative overflow-hidden bg-dark-900">
      <div class="absolute inset-0 bg-gradient-to-b from-dark-800 via-dark-900 to-dark-800"></div>
      
      <div class="container mx-auto px-6 relative z-10">
        <div class="text-center mb-20">
          <div class="inline-flex items-center gap-3 mb-6">
            <div class="w-12 h-0.5 bg-gradient-to-r from-transparent to-primary"></div>
            <span class="text-primary font-semibold tracking-widest uppercase text-sm">Tecnologías</span>
            <div class="w-12 h-0.5 bg-gradient-to-l from-transparent to-primary"></div>
          </div>
          <h2 class="text-6xl font-black mb-6 text-white">
            Mi <span class="text-primary">Arsenal</span> Tecnológico
          </h2>
          <p class="text-dark-200 text-xl max-w-3xl mx-auto leading-relaxed">
            Domino un amplio ecosistema de tecnologías modernas para crear soluciones robustas y escalables
          </p>
        </div>

        <div class="space-y-12">
          <div class="tech-row tech-row-ltr overflow-hidden">
            <div class="tech-track flex gap-8 items-center">
              {
                [
                  { name: "JavaScript", icon: "devicon-javascript-plain", color: "#FFFFFF" },
                  { name: "TypeScript", icon: "devicon-typescript-plain", color: "#FF1E56" },
                  { name: "React", icon: "devicon-react-original", color: "#FFFFFF" },
                  { name: "Angular", icon: "devicon-angularjs-plain", color: "#FF1E56" },
                  { name: "Vue.js", icon: "devicon-vuejs-plain", color: "#FFFFFF" },
                  { name: "Astro", icon: "devicon-astro-plain", color: "#FF1E56" },
                  { name: "Next.js", icon: "devicon-nextjs-original", color: "#FFFFFF" },
                  { name: "Tailwind", icon: "devicon-tailwindcss-plain", color: "#FF1E56" },
                  // Duplicamos para scroll infinito
                  { name: "JavaScript", icon: "devicon-javascript-plain", color: "#FFFFFF" },
                  { name: "TypeScript", icon: "devicon-typescript-plain", color: "#FF1E56" },
                  { name: "React", icon: "devicon-react-original", color: "#FFFFFF" },
                  { name: "Angular", icon: "devicon-angularjs-plain", color: "#FF1E56" },
                  { name: "Vue.js", icon: "devicon-vuejs-plain", color: "#FFFFFF" },
                  { name: "Astro", icon: "devicon-astro-plain", color: "#FF1E56" },
                  { name: "Next.js", icon: "devicon-nextjs-original", color: "#FFFFFF" },
                  { name: "Tailwind", icon: "devicon-tailwindcss-plain", color: "#FF1E56" }
                ].map((tech, index) => (
                  <div 
                    class="tech-icon-item flex-shrink-0 bg-dark-800/60 backdrop-blur-sm rounded-xl p-4 border border-dark-700 hover:border-primary/50 transition-colors duration-300"
                    title={tech.name}
                  >
                    <i 
                      class={`${tech.icon} text-4xl`}
                      style={`color: ${tech.color}`}
                    />
                  </div>
                ))
              }
            </div>
          </div>

          <div class="tech-row tech-row-rtl overflow-hidden">
            <div class="tech-track flex gap-8 items-center">
              {
                [
                  { name: "Python", icon: "devicon-python-plain", color: "#FFFFFF" },
                  { name: ".NET", icon: "devicon-dotnetcore-plain", color: "#FF1E56" },
                  { name: "Java", icon: "devicon-java-plain", color: "#FFFFFF" },
                  { name: "Node.js", icon: "devicon-nodejs-plain", color: "#FF1E56" },
                  { name: "Spring", icon: "devicon-spring-plain", color: "#FFFFFF" },
                  { name: "NestJS", icon: "devicon-nestjs-plain", color: "#FF1E56" },
                  { name: "Flask", icon: "devicon-flask-original", color: "#FFFFFF" },
                  { name: "Express", icon: "devicon-express-original", color: "#000000" },
                  // Duplicamos para scroll infinito
                  { name: "Python", icon: "devicon-python-plain", color: "#FFFFFF" },
                  { name: ".NET", icon: "devicon-dotnetcore-plain", color: "#FF1E56" },
                  { name: "Java", icon: "devicon-java-plain", color: "#FFFFFF" },
                  { name: "Node.js", icon: "devicon-nodejs-plain", color: "#FF1E56" },
                  { name: "Spring", icon: "devicon-spring-plain", color: "#FFFFFF" },
                  { name: "NestJS", icon: "devicon-nestjs-plain", color: "#FF1E56" },
                  { name: "Flask", icon: "devicon-flask-original", color: "#FFFFFF" },
                  { name: "Express", icon: "devicon-express-original", color: "#000000" }
                ].map((tech, index) => (
                  <div 
                    class="tech-icon-item flex-shrink-0 bg-dark-800/60 backdrop-blur-sm rounded-xl p-4 border border-dark-700 hover:border-primary/50 transition-colors duration-300"
                    title={tech.name}
                  >
                    <i 
                      class={`${tech.icon} text-4xl`}
                      style={`color: ${tech.color}`}
                    />
                  </div>
                ))
              }
            </div>
          </div>

          <div class="tech-row tech-row-ltr overflow-hidden">
            <div class="tech-track flex gap-8 items-center">
              {
                [
                  { name: "Docker", icon: "devicon-docker-plain", color: "#FFFFFF" },
                  { name: "Kubernetes", icon: "devicon-kubernetes-plain", color: "#FF1E56" },
                  { name: "MongoDB", icon: "devicon-mongodb-plain", color: "#FFFFFF" },
                  { name: "PostgreSQL", icon: "devicon-postgresql-plain", color: "#FF1E56" },
                  { name: "Redis", icon: "devicon-redis-plain", color: "#FF1E56" },
                  { name: "AWS", icon: "devicon-amazonwebservices-plain", color: "#FFFFFF" },
                  { name: "Google Cloud", icon: "devicon-googlecloud-plain", color: "#FF1E56" },
                  { name: "Git", icon: "devicon-git-plain", color: "#FF1E56" },
                  // Duplicamos para scroll infinito
                  { name: "Docker", icon: "devicon-docker-plain", color: "#FFFFFF" },
                  { name: "Kubernetes", icon: "devicon-kubernetes-plain", color: "#FF1E56" },
                  { name: "MongoDB", icon: "devicon-mongodb-plain", color: "#FFFFFF" },
                  { name: "PostgreSQL", icon: "devicon-postgresql-plain", color: "#FF1E56" },
                  { name: "Redis", icon: "devicon-redis-plain", color: "#FF1E56" },
                  { name: "AWS", icon: "devicon-amazonwebservices-plain", color: "#FFFFFF" },
                  { name: "Google Cloud", icon: "devicon-googlecloud-plain", color: "#FF1E56" },
                  { name: "Git", icon: "devicon-git-plain", color: "#FF1E56" }
                ].map((tech, index) => (
                  <div 
                    class="tech-icon-item flex-shrink-0 bg-dark-800/60 backdrop-blur-sm rounded-xl p-4 border border-dark-700 hover:border-primary/50 transition-colors duration-300"
                    title={tech.name}
                  >
                    <i 
                      class={`${tech.icon} text-4xl`}
                      style={`color: ${tech.color}`}
                    />
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="education" class="py-20 relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-dark-800 via-dark-900 to-dark-800"></div>
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 1px 1px, rgba(255,30,86,0.3) 1px, transparent 0); background-size: 30px 30px;"></div>
      
      <div class="container mx-auto px-6 relative z-10">
        <div class="text-center mb-20">
          <div class="inline-flex items-center gap-3 mb-6">
            <div class="w-12 h-0.5 bg-gradient-to-r from-transparent to-primary"></div>
            <span class="text-primary font-semibold tracking-widest uppercase text-sm">Educación</span>
            <div class="w-12 h-0.5 bg-gradient-to-l from-transparent to-primary"></div>
          </div>
          <h2 class="text-6xl font-black mb-6 text-white">
            Mi <span class="text-primary">Formación</span>
          </h2>
          <p class="text-gray-300 text-xl max-w-3xl mx-auto leading-relaxed">
            Fundamentos sólidos en ingeniería de software y constante aprendizaje en tecnologías emergentes
          </p>
        </div>

        <div class="max-w-5xl mx-auto">
